<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.chagui68</groupId>
    <artifactId>MultiverseNets</artifactId>
    <version>5.2</version>
    <packaging>jar</packaging>

    <name>MultiverseNets</name>
    <description>Redes de logistica digital y almacenamiento masivo standalone para Paper, sin Slimefun.</description>

    <organization>
        <name>Chagui68</name>
    </organization>

    <licenses>
        <license>
            <name>GNU General Public License, Version 3</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven.compiler.release>${java.version}</maven.compiler.release>

        <paper.version>1.21.11-R0.1-SNAPSHOT</paper.version>
        <lombok.version>1.18.46</lombok.version>
        <jsr305.version>3.0.2</jsr305.version>
        <junit.version>6.1.2</junit.version>
        <mockbukkit.version>4.110.0</mockbukkit.version>
        <surefire.version>3.5.6</surefire.version>
    </properties>

    <build>
        <finalName>${project.name}-v${project.version}</finalName>
        <defaultGoal>clean package</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>
    </build>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.code.findbugs</groupId>
            <artifactId>jsr305</artifactId>
            <version>${jsr305.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockbukkit.mockbukkit</groupId>
            <artifactId>mockbukkit-v1.21</artifactId>
            <version>${mockbukkit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
        Supported servers: Paper / Purpur 1.21.11, 26.1 and 26.2.
        The release jar is built against the 1.21.11 API with Java 21 bytecode, so the same jar
        runs on all three. The two extra profiles compile the same sources against the newer Paper
        APIs, so a call that does not exist there is caught before release (they need JDK 25,
        like those servers):
            mvn -P api-26.1 clean compile
            mvn -P api-26.2 clean compile
        Servidores soportados: Paper / Purpur 1.21.11, 26.1 y 26.2. El jar se compila contra la API
        1.21.11 con bytecode de Java 21 y funciona en las tres; los perfiles compilan el mismo
        codigo contra las APIs nuevas para detectar antes de publicar lo que alli no existe.
    -->
    <profiles>
        <profile>
            <id>api-26.1</id>
            <properties>
                <paper.version>26.1.2.build.74-stable</paper.version>
            </properties>
        </profile>
        <profile>
            <id>api-26.2</id>
            <properties>
                <paper.version>26.2.build.129-stable</paper.version>
            </properties>
        </profile>
    </profiles>
</project>
